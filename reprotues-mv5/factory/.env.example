# Required for the primary map provider. Use a browser-restricted key with the
# Maps JavaScript API and Routes API enabled. OpenStreetMap is used only when
# Google Maps genuinely fails to load or authenticate.
# During local development, allow http://localhost:4000/*,
# http://127.0.0.1:4000/*, and the equivalent port 4001 referrers when the
# backend serves the production frontend build.
VITE_GOOGLE_MAPS_API_KEY=

# Required Google Cloud JavaScript Map ID for Advanced Markers. Create a
# project-owned Vector Map ID; do not use DEMO_MAP_ID outside local experiments.
VITE_GOOGLE_MAPS_MAP_ID=

# Use "openstreetmap" for local development without Google Cloud referrer
# configuration. Use "google" only after the site origin is allowed on the key.
VITE_MAP_PROVIDER=openstreetmap

# Displayed at the bottom of the frontend application.
VITE_APP_VERSION=1.0.0
VITE_MANAGER_APP_VERSION=1
VITE_SALES_APP_VERSION=2
VITE_FACTORY_APP_VERSION=3

# Separate local loopback address for each portal. All portals are served by
# the same Vite process and port; only the browser hostname changes.
VITE_MANAGER_PORTAL_HOST=127.0.0.1
VITE_SALES_PORTAL_HOST=127.0.0.2
VITE_FACTORY_PORTAL_HOST=127.0.0.3

# Restart Vite after changing either Maps value. Local values may be placed in
# frontend/.env.local (recommended and git-ignored) or frontend/.env.

# Optional secure tracking stream, for example wss://api.example.com/tracking.
VITE_TRACKING_WS_URL=

# Optional backend and Socket.IO origins. Leave blank for local development so
# Vite's same-origin proxy routes requests to the development backend.
# For a separately hosted environment, set both to that environment's HTTPS API origin.
VITE_API_URL=same-origin
# Local development proxies Socket.IO through Vite. On Vercel, set this to
# the public Render origin because live WebSocket upgrades connect directly.
VITE_TRACKING_SOCKET_URL=same-origin

# GPS fixes above this radius show a warning, but valid coarse coordinates are
# still sent so desktop/network-based tracking does not disappear.
VITE_GPS_POOR_ACCURACY_METERS=100
