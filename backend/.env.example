NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# MySQL Database Configuration
# For local development connecting to remote Hostinger: DB_HOST=srv345.hstgr.io
# For live server running on Hostinger: DB_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u692454198_reproutes
DB_USER=u692454198_reproutes
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql://u692454198_reproutes:your_mysql_password@127.0.0.1:3306/u692454198_reproutes

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-different-from-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=reproutes-api
JWT_AUDIENCE=reproutes-clients

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://api.reproutes.com,https://manager.reproutes.com,https://factory.reproutes.com,https://reproutes.com,https://www.reproutes.com

# Reverse Proxy (1 for single reverse proxy like Apache/LiteSpeed/Nginx)
TRUST_PROXY_HOPS=1
ENFORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Local Storage
LOCAL_STORAGE_DIR=uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reproutes <no-reply@reproutes.com>
OTP_TTL_MINUTES=10

# WebAuthn
WEBAUTHN_RP_ID=reproutes.com
WEBAUTHN_ORIGIN=https://reproutes.com
WEBAUTHN_RP_NAME=Reproutes

# Optional Integrations
GOOGLE_GENAI_API_KEY=
GPS_HISTORY_RETENTION_DAYS=90
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
